{
  "name": "paseo-plugin-launcher",
  "version": "0.2.0",
  "type": "module",
  "description": "One sidebar row that lists every installed Paseo plugin and navigates to its sidebar screen.",
  "license": "MIT",
  "author": "Gordon Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0rdonL/paseo-plugin-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/g0rdonL/paseo-plugin-launcher/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "plugin-launcher"
  ],
  "files": [
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "paseo-plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@getpaseo/client": "0.10.3",
    "@getpaseo/plugin": "0.10.3",
    "@getpaseo/protocol": "0.10.3",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "4.4.3"
  },
  "homepage": "https://github.com/g0rdonL/paseo-plugin-launcher#readme"
}
